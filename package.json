{
  "name": "callwalkietalkie",
  "version": "0.9.0",
  "description": "Run local laptop agents from your phone. Uses the free WalkieTalkie relay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbened/walkietalkie.git"
  },
  "homepage": "https://callwalkietalkie.com",
  "type": "module",
  "bin": {
    "callwalkietalkie": "bin/callwalkietalkie.js",
